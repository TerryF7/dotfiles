# directory navigation
alias ..='cd ..'
alias ...='cd ../..'

# avoid overwrite
alias cp='cp -i'
alias mv='mv -i'

# mkdir
alias mkdir='mkdir -pv'

# cat
alias cat='bat'

# chezmoi
alias cm='chezmoi'

# clear
alias cls='clear'

# du
alias du='dust'

# git
alias g='git'

# lazygit
alias lg='lazygit'

# ls
alias ls='eza'
alias la='eza -a'
alias ll='eza -lah'
alias tree='eza --tree --level=2'

# nvim
alias v='nvim'

# yazi
alias yz='yazi'
